# Skopíruj do .env.local pre lokálny vývoj. Bez hodnôt appka beží s ukážkovými
# dátami a ukladá do pamäte. Na Verceli nastav rovnaké premenné v
# Settings → Environment Variables.

# --- Prístup (povinné v produkcii) ---
# Heslo, ktorým sa Adelka prihlási. Bez neho je produkčná appka zamknutá.
APP_PASSWORD=

# --- Supabase (už nastavené vo Verceli) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (Claude API) ---
ANTHROPIC_API_KEY=
# Voliteľné, predvolený je claude-opus-5
# ANTHROPIC_MODEL=

# --- Denný sync a email notifikácie ---
# Náhodný reťazec; Vercel Cron ho posiela v hlavičke Authorization.
CRON_SECRET=
RESEND_API_KEY=
# Kam posielať upozornenia (viac adries oddeľ čiarkou)
NOTIFY_EMAIL=
# Odosielateľ; vyžaduje overenú doménu v Resende (inak onboarding@resend.dev)
# EMAIL_FROM=Domček pri mori <noreply@orszagh.online>
# Verejná adresa appky pre odkazy v emailoch (predvolene produkčná Vercel URL)
# APP_URL=https://adel.orszagh.online

# --- Zdroj inzerátov ---
# mock = ukážkové dáta, apify = Idealista.it + Immobiliare.it cez Apify
PROPERTY_PROVIDER=mock
# Apify API token (console.apify.com → Settings → API & Integrations)
APIFY_TOKEN=
# Max. inzerátov na portál a oblasť pri jednom sťahovaní (predvolene 50)
# APIFY_MAX_ITEMS=50
# Max. cena jedného Apify behu v USD (predvolene 0.25)
# APIFY_MAX_CHARGE_USD=0.25
