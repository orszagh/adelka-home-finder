        "APP_PASSWORD": "",
        "APIFY_TOKEN": "",
        "RESEND_API_KEY": "",
        "ANTHROPIC_API_KEY": "",
        "NEXT_DIST_DIR": ".next-mock"
      }
    }
  ]
}
